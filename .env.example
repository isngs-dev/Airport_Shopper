# Destination of all three APPLY buttons (baked in at build time)
VITE_APPLY_URL=https://example.com/apply

# --- Contact form mail (read by server/index.mjs, never exposed to the browser) ---
# Without SENDGRID_API_KEY the server runs in dry-run mode: mails are logged, not sent.
SENDGRID_API_KEY=
# Must be a verified sender in SendGrid
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=iSN
# Fallback meeting link, used when Google Calendar below is not configured
MEETING_LINK=
# Optional: receives a copy of every lead (comma separated)
NOTIFY_EMAIL=

# --- Google Calendar (optional): real free/busy slots + a Google Meet link per booking ---
# Create "Desktop app" OAuth credentials, then run `npm run google:auth` once to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Booking rules ---
MEETING_TIMEZONE=Asia/Kolkata
MEETING_START_HOUR=9
MEETING_END_HOUR=18
MEETING_DURATION_MIN=30
MEETING_WEEKDAYS=Mon,Tue,Wed,Thu,Fri
MEETING_MIN_NOTICE_HOURS=2
MEETING_MAX_DAYS=60
