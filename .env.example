# --- Google (Calendar + Gmail) ---
# 1. Google Cloud: enable the Google Calendar API AND the Gmail API, create "Desktop app" OAuth credentials.
# 2. `npm run google:auth` once, signed in as the account that owns the calendar and sends the mails.
# Without these the server runs in dry-run mode (mails are logged, not sent).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Confirmation mail (sent with the Gmail API) ---
# Must be the account the token belongs to
MAIL_FROM_EMAIL=
# Header, subject and sender name
EMAIL_BRAND=Airport Mystery Shopping
EMAIL_TEAM=iSN
# Gets every confirmation in Cc (comma separated)
MAIL_CC=
# Public URL of the site (shown in the mail footer), no trailing slash
SITE_URL=
# Fallback meeting link when Google Calendar is not configured
MEETING_LINK=

# --- Booking rules ---
MEETING_TIMEZONE=America/New_York
MEETING_START_HOUR=9
MEETING_END_HOUR=18
MEETING_DURATION_MIN=30
MEETING_WEEKDAYS=Mon,Tue,Wed,Thu,Fri
MEETING_MIN_NOTICE_HOURS=2
MEETING_MAX_DAYS=60
